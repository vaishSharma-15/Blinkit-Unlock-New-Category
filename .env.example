# Get a key at https://aistudio.google.com/apikey
# Copy this file to .env.local for local dev, and set the same variable in
# Vercel's project settings before deploying. Never commit the real key.
GEMINI_API_KEY=

# Optional. Overrides the model in lib/ai.js. Free-tier quota is per model, so
# switching here is the quickest way past a "quota reached" card during a demo.
# Known-good alternatives: gemini-3.5-flash, gemini-3.5-flash-lite
GEMINI_MODEL=
