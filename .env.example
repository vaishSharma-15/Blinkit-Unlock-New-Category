# Get a key at https://aistudio.google.com/apikey
# Copy this file to .env.local for local dev, and set the same variable in
# Vercel's project settings before deploying. Never commit the real key.
GEMINI_API_KEY=

# Optional. Overrides the default in lib/ai.js (gemini-3.1-flash-lite, chosen
# for the highest free-tier daily request ceiling of the models this project's
# API keys can reach — the 2.5 series 404s as "no longer available to new
# users"). Free-tier quota is per model, so switching here is the quickest way
# past a "quota reached" card during a demo. Known-reachable alternatives:
# gemini-3.5-flash, gemini-3.6-flash.
GEMINI_MODEL=
